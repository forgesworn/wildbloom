{
  "name": "wildbloom",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A local-first Nostr, Blossom and BitTorrent interoperability prototype.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "secrets": "node scripts/secret-scan.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke:browser && npm run secrets",
    "ci": "npm run check && npm run audit"
  },
  "dependencies": {
    "create-torrent": "6.1.3",
    "nostr-tools": "2.25.0",
    "path-browserify": "1.0.1",
    "parse-torrent": "11.0.24",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@types/create-torrent": "6.1.1",
    "@types/node": "24.10.13",
    "@types/path-browserify": "1.0.3",
    "@types/parse-torrent": "11.0.1",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
